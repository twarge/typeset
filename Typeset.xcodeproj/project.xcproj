{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    {
      "kind": "group",
      "path": "Sources",
      "children": [
        { "kind": "folder", "path": "TypesetCore", "target-membership": [ "TypesetCore" ] },
        { "kind": "folder", "path": "TypesetApp", "target-membership": [ "Typeset" ] },
        { "kind": "folder", "path": "TypesetQuickLook", "target-membership": [ "TypesetQuickLook" ] },
        { "kind": "folder", "path": "TypesetSpotlight", "target-membership": [ "TypesetSpotlight" ] },
        { "kind": "folder", "path": "TypesetThumbnail", "target-membership": [ "TypesetThumbnail" ] },
      ],
    }, {
      "kind": "group",
      "path": "Tests",
      "children": [
        { "kind": "folder", "path": "TypesetCoreTests", "target-membership": [ "TypesetCoreTests" ] },
      ],
    }, {
      "kind": "group",
      "path": "Config",
      "children": [
        { "path": "Typeset-Info.plist" },
        { "path": "TypesetQuickLook-Info.plist" },
        { "path": "TypesetSpotlight-Info.plist" },
        { "path": "TypesetThumbnail-Info.plist" },
      ],
    },
    { "path": "<PROJECT>/Vendor/TypesetLang.xcframework", "target-membership": [ "TypesetCore/frameworks" ] },
    {
      "kind": "group",
      "name": "Resources",
      "children": [
        { "path": "<PROJECT>/Resources/Assets.xcassets", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/AppIcon.icon", "target-membership": [ "Typeset/resources" ] },
        {
          "path": "<PROJECT>/Resources/PrivacyInfo.xcprivacy",
          "target-membership": [
            "Typeset/resources",
            "TypesetCore/resources",
          ],
        },
        { "path": "<PROJECT>/Resources/Acknowledgements/Acknowledgements.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/Typst-LICENSE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/Typst-NOTICE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/Tinymist-LICENSE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/Tinymist-cmark-writer-LICENSE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/FiraCode-LICENSE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/NotoSansCJK-LICENSE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-Light.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-Regular.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-Retina.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-Medium.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-SemiBold.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/FiraCode/FiraCode-Bold.ttf", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Fonts/NotoCJK", "target-membership": [ "TypesetCore/resources" ] },
        { "path": "<PROJECT>/Resources/TypstPackages", "target-membership": [ "TypesetCore/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/TypstPackages-NOTICE.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Localizable.xcstrings", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/GPL-3.0.txt", "target-membership": [ "Typeset/resources" ] },
        { "path": "<PROJECT>/Resources/Acknowledgements/EPL-2.0.txt", "target-membership": [ "Typeset/resources" ] },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        {
          "path": "<PRODUCTS>/TypesetCore.framework",
          "id": "100000000000000000000201",
          "type": "wrapper.framework",
          "index": false,
          "target-membership": [
            "Typeset/frameworks",
            { "build-phase": "Typeset/copy/Embed Frameworks", "code-sign-on-copy": true, "header-preservation": "remove-on-copy" },
            "TypesetQuickLook/frameworks",
            "TypesetSpotlight/frameworks",
            "TypesetThumbnail/frameworks",
            "TypesetCoreTests/frameworks",
          ],
        },
        { "path": "<PRODUCTS>/Typeset.app", "id": "100000000000000000000202", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/TypesetQuickLook.appex", "id": "300000000000000000000201", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Typeset/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TypesetSpotlight.appex", "id": "500000000000000000000201", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Typeset/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TypesetThumbnail.appex", "id": "400000000000000000000201", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "Typeset/copy/Embed Foundation Extensions", "platforms": [ "macos" ], "code-sign-on-copy": true, "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/TypesetCoreTests.xctest", "id": "100000000000000000000203", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Typeset",
      "id": "100000000000000000000802",
      "product": "Products/Typeset.app",
      "product-type": "application",
      "dependencies": [
        "TypesetCore",
        { "target": "TypesetQuickLook", "platforms": [ "macos" ] },
        { "target": "TypesetSpotlight", "platforms": [ "macos" ] },
        { "target": "TypesetThumbnail", "platforms": [ "macos" ] },
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Frameworks",
          "bundle-base-path": "frameworks-directory",
        }, {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "build-settings": {
        "ARCHS[sdk=macosx*]": "arm64",
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS[sdk=iphone*]": "Config/Typeset-iOS.entitlements",
        "CODE_SIGN_ENTITLEMENTS[sdk=macosx*]": "Config/Typeset.entitlements",
        "CODE_SIGN_IDENTITY": "Apple Development",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "4",
        "DEAD_CODE_STRIPPING": "YES",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "EXCLUDED_ARCHS[sdk=macosx*]": "x86_64",
        "EXCLUDED_ARCHS[sdk=xrsimulator*]": "x86_64",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Config/Typeset-Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "Typeset",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.productivity",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@loader_path/Frameworks",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "26.0",
        "MARKETING_VERSION": "1.3",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.twarge.app.typeset",
        "PRODUCT_NAME": "Typeset",
        "PROVISIONING_PROFILE_SPECIFIER": "",
        "SDKROOT": "auto",
        "SUPPORTED_PLATFORMS": "macosx iphoneos iphonesimulator xros xrsimulator",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "TARGETED_DEVICE_FAMILY": "1,2,6,7",
      },
    }, {
      "name": "TypesetQuickLook",
      "id": "300000000000000000000801",
      "product": "Products/TypesetQuickLook.appex",
      "product-type": "app-extension",
